# Скопируйте в .env и поменяйте при необходимости. Все значения необязательны — есть значения по умолчанию.

# Порт веб-интерфейса (http://localhost:8080)
APP_PORT=8080

# PostgreSQL 16
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=slides

# Сессии: срок жизни и флаг Secure у cookie (включите за HTTPS)
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# Максимальный размер загружаемого файла, МБ
MAX_UPLOAD_MB=100

# Темп стадий-заглушек пайплайна: 1 — «как в жизни» (~15 с), 0 — мгновенно
MOCK_SPEED=1

# Рендер .pptx через LibreOffice: лимит времени и число параллельных процессов
RENDER_TIMEOUT_SECONDS=180
RENDER_CONCURRENCY=2

# VLM-разметка паттернов слайдов (необязательно; без неё работают правила парсера).
# Любой OpenAI-совместимый /chat/completions с картинками, модели с открытыми весами до 35B:
#   свой vLLM/SGLang:    VLM_BASE_URL=http://vllm:8000/v1            VLM_MODEL=Qwen/Qwen3.8-27B
#   Yandex AI Studio:    VLM_BASE_URL=https://llm.api.cloud.yandex.net/v1  VLM_MODEL=gpt://<folder_id>/qwen3.6-35b-a3b/latest
#   Cloud.ru Evolution:  VLM_BASE_URL=https://foundation-models.api.cloud.ru/v1  VLM_MODEL=Qwen/Qwen3.6-35B-A3B
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
VLM_TIMEOUT_SECONDS=90
VLM_MAX_PATTERNS=40
VLM_CONCURRENCY=4

# Только для docker-compose.dev.yml
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_DEV_PORT=5173

# Скопируйте в .env и поменяйте при необходимости. Все значения необязательны — есть значения по умолчанию.

# Порт веб-интерфейса (http://localhost:8080)
APP_PORT=8080

# PostgreSQL 16
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=slides

# Сессии: срок жизни и флаг Secure у cookie (включите за HTTPS)
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# Технический аккаунт для кнопки «Войти как тестовый эксперт»
DEMO_USER_EMAIL=demo.expert@vk.tech
DEMO_USER_NAME=Тестовый эксперт

# Максимальный размер загружаемого файла, МБ
MAX_UPLOAD_MB=100

# Кэш разбора шаблонов контент-пакета (каталог cache/ репозитория монтируется в /cache).
# С ним первый запуск не ждёт LibreOffice и не тратит запросы к VLM. Пусто — разбор с нуля.
TEMPLATE_CACHE_DIR=/cache

# Рендер .pptx через LibreOffice: лимит времени и число параллельных процессов.
# Большой шаблон (90 страниц) — 1–3 минуты; при 4 ГБ памяти Docker надёжнее один процесс.
RENDER_TIMEOUT_SECONDS=420
# Два процесса LibreOffice: три варианта рендерятся примерно на 40% быстрее, пик памяти воркера ~1,3 ГБ.
# Больше двух не ускоряет (сборка .pptx упирается в Python); при нехватке памяти Docker — 1.
RENDER_CONCURRENCY=2

# LLM: план колоды, тексты слайдов и правка слайда из чата (необязательно; без неё колода
# собирается из тезисов брифа как есть, правка из чата недоступна).
# Модель с открытыми весами до 35B по ТЗ, OpenAI-совместимый /chat/completions:
#   RouterAI:            LLM_BASE_URL=https://routerai.ru/api/v1     LLM_MODEL=qwen/qwen3.8-27b
#   свой vLLM/SGLang:    LLM_BASE_URL=http://vllm:8000/v1            LLM_MODEL=Qwen/Qwen3.8-27B
# Несколько ключей одного провайдера — через запятую: каждый запрос уходит на наименее загруженный ключ,
# две генерации одновременно расходятся по разным ключам. Ключ, ответивший 429 (лимит) или 401/402/403
# (нет доступа, кончился баланс), на время выводится из оборота, запрос повторяется на другом.
# Так же через запятую задаются AUDIT_API_KEY, VLM_API_KEY и T2I_API_KEY.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Один запрос на слайд идут параллельно; план колоды — длинный ответ, ему нужен запас токенов.
LLM_CONCURRENCY=4
LLM_MAX_TOKENS=1600
LLM_TEMPERATURE=0.3
LLM_DISABLE_REASONING=true
# Сколько знаков контент-пакета уходит в промпт: на файл и суммарно.
LLM_SOURCE_CHARS=4000
LLM_SOURCES_TOTAL_CHARS=12000

# Модель-судья аудита: контекстуальные проверки по тексту колоды и по рендерам слайдов с картинками
# (модель должна понимать изображения). Пустые поля берутся из LLM_* — отдельная модель не обязательна.
# Без модели часть контекстуальных проверок работает по запасным правилам, остальные недоступны.
#   RouterAI:            AUDIT_MODEL=qwen/qwen3.8-27b
AUDIT_BASE_URL=
AUDIT_API_KEY=
AUDIT_MODEL=
AUDIT_TIMEOUT_SECONDS=180
# Разбор колоды — по строке вердиктов на слайд, ответ длинный.
AUDIT_MAX_TOKENS=6000
AUDIT_CONCURRENCY=6
# Сколько генерация ждёт судью после рендера; не успел — вердикты догоняют в фоне, отчёт обновится сам.
AUDIT_WAIT_SECONDS=60

# VLM-разметка паттернов слайдов (необязательно; без неё работают правила парсера).
# Любой OpenAI-совместимый /chat/completions с картинками, модели с открытыми весами до 35B:
#   RouterAI:            VLM_BASE_URL=https://routerai.ru/api/v1     VLM_MODEL=qwen/qwen3.8-27b
#   свой vLLM/SGLang:    VLM_BASE_URL=http://vllm:8000/v1            VLM_MODEL=Qwen/Qwen3.8-27B
#   Yandex AI Studio:    VLM_BASE_URL=https://llm.api.cloud.yandex.net/v1  VLM_MODEL=gpt://<folder_id>/qwen3.6-35b-a3b/latest
#   Cloud.ru Evolution:  VLM_BASE_URL=https://foundation-models.api.cloud.ru/v1  VLM_MODEL=Qwen/Qwen3.6-35B-A3B
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
VLM_TIMEOUT_SECONDS=90
VLM_MAX_PATTERNS=60
VLM_CONCURRENCY=6
VLM_MAX_TOKENS=900
# Рассуждения гибридных моделей (Qwen3.x) выключаются параметром reasoning (RouterAI/OpenRouter).
# Для vLLM вместо него: VLM_DISABLE_REASONING=false и VLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
VLM_DISABLE_REASONING=true
VLM_EXTRA_BODY=

# Text-to-image: иллюстрации для слайдов «текст и изображение» (ТЗ, п. 3.1; необязательно — без неё
# такие слайды не планируются). Открытые веса до 20B: FLUX.2 [klein] 4B, Apache 2.0, ~13 ГБ видеопамяти.
#   RouterAI:     T2I_BASE_URL=https://routerai.ru/api/v1  T2I_MODEL=black-forest-labs/flux.2-klein-4b  T2I_API=chat
#   свой сервер:  T2I_BASE_URL=http://t2i:8000/v1  T2I_MODEL=black-forest-labs/FLUX.2-klein-4B  T2I_API=images
# T2I_API: chat — /chat/completions с modalities ["image"]; images — OpenAI Images API /images/generations.
# Пустой T2I_API_KEY — берётся LLM_API_KEY, если модель у того же провайдера (тот же хост).
T2I_BASE_URL=
T2I_API_KEY=
T2I_MODEL=
T2I_API=chat
# Картинка рисуется 6–14 с: запрос дольше T2I_TIMEOUT_SECONDS считается зависшим и повторяется.
T2I_TIMEOUT_SECONDS=40
# Сколько генерация ждёт картинки с начала рисования; не успевшие — слайды тезисами (лимит 5 минут).
T2I_WAIT_SECONDS=60
# Картинки рисуются параллельно; на колоду (три варианта вместе) — не больше T2I_MAX_IMAGES.
T2I_CONCURRENCY=4
T2I_MAX_IMAGES=8
# Сид первой картинки: те же тексты и шаблон дают те же картинки.
T2I_SEED=2026

# Только для docker-compose.dev.yml
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_DEV_PORT=5173
